# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swornali_jewellers?schema=public"

# Authentication (use long, unique values in deployed environments)
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment provider adapter configuration
PAYMENT_PROVIDER_KEY=""

# Application URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
