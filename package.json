    "chokidar": "^3.6.0",
    "didyoumean": "^1.2.2",
    "dlv": "^1.1.3",
    "electron-to-chromium": "^1.5.407",
    "glob-parent": "^6.0.2",
    "node-releases": "^2.0.53",
    "object-hash": "^3.0.0",
